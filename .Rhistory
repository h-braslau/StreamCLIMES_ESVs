Anova(leaf_C)
emmeans(leaf_C, pairwise ~ shd_trt)
emmeans(leaf_C, pairwise ~ fert_trt*shd_trt)
leafC_ab <- data.frame(x.value = c(0.95, 1.95),
y.value = c(47.1, 46.05),
letter = c("A","B"))
ggplot(leaf, aes(x=per_thin, y=per_c))+
geom_boxplot(color = "springgreen4", fill = "lightgreen") +
labs(title= "Effect of thinning on leaf % C",
y="Percent Carbon", x = "Percent Thinned") +
geom_text(data = leafC_ab,
aes(x = x.value, y = y.value, label = letter),
color = "springgreen4", size = 4) +
theme_classic()
leafC_aa <- data.frame(x.value = c(0.95, 1.95),
y.value = c(46.2, 46.8),
letter = c("A","A"))
ggplot(leaf, aes(x=shd_trt, y=per_c))+
geom_boxplot(color = "springgreen4", fill = "lightgreen")+
labs(title= "Effect of shade treatment on leaf % C",
y="Percent Carbon", x = "Shade Treatment") +
geom_text(data = leafC_aa,
aes(x = x.value, y = y.value, label = letter),
color = "springgreen4", size = 4) +
theme_classic()
leaf_CN <- lm(c_n ~ per_thin * shd_trt * fert_trt, data = leaf)
summary(leaf_CN)
Anova(leaf_CN)
emmeans(leaf_CN, pairwise ~ shd_trt)
library(tidyverse)
library(readxl)
library(ggthemes)
library(ritis)
Tric_itis<-itis_facet(q = "hierarchySoFar:*$Trichoptera$* AND rank:Species AND usage:valid",
facet.pivot = "tsn", facet.limit = -1, facet.mincount = 1,
rows = 0)
#this gets list of valid species tsn (taxonomic serial numbers) that you can use to pull further information
Tric_tsn<-Tric_itis$facet_pivot$tsn%>%
unnest(cols=tsn)%>%
select(tsn)%>%
arrange(tsn)
#what does our count look like
count(Tric_tsn)#11513 observations
##now get hierarchy for these-- this takes a minute depending on number of entries in tsn list####
Tric_hierarchy<-Tric_tsn%>%
rowwise()%>%
#apply hierarchy function to each tsn and keep columns 3 and 4 to create list of hierarchies
mutate(hierarchy=list(hierarchy_full(tsn)[,3:4]))
