updat <- read.csv("/Users/hannahbraslau/Documents/Documents - Hannah’s MacBook Air/Garcia Lab/GitHub/CAcropData/maintable_2024-02-25.csv", header=T)
head(updat)
unique(updat$CropName)
unique(updat$County)
pist_updat <- updat %>%
filter(CropName == "Pistachio")
countypistfilt <- c("", "SanBernardino" , "StateTotals", "SumofOthers", "StateTotal","SanLuisObispo", "ContraCosta", "Glenn")
pist_updat_filtcounty <- pist_updat[!pist_updat$County %in% countypistfilt, ]
pist_updat_filt <- pist_updat_filtcounty[pist_updat_filtcounty$Yield >-1,]
pist_updat_filt <- pist_updat_filt[pist_updat_filt$Year < 2020,]
pist_updat_filt <- pist_updat_filt %>%
arrange(County, Year)
pist_updat_filt = pist_updat_filt[pist_updat_filt$Year >1980,]
# Count the number of years for each county
years_per_county <- pist_updat_filt %>%
group_by(County) %>%
summarise(num_years = n_distinct(Year))
# Print the result
print(years_per_county)
pist_updatfix <- merge(pist_updat_filt,years_per_county, by ="County" )
pist_updatfix <- pist_updatfix[pist_updatfix$num_years == 39,]
# List to store detrended data frames
detrended_data_list <- list()
# Get unique county names
counties <- unique(pist_updatfix$County)
# Iterate over each county
for (county in counties) {
# Check if the county has already been processed
if (!(county %in% names(detrended_data_list))) {
# Subset data for the current county
pist_updatfix_i <- pist_updatfix[pist_updatfix$County == county, ]
# Fit GAM model to detrend the production time series
gam_model <- gam(Yield ~ s(Year), data = pist_updatfix_i)
# Detrend the production time series
detrended_production <- residuals(gam_model)
# Create a new data frame with detrended production
detrended_data <- data.frame(
county = county,
year = pist_updatfix_i$Year,
detrended_yield = detrended_production
)
# Store detrended data frame in the list
detrended_data_list[[county]] <- detrended_data
}
}
for (county in counties) {
# Check if the county has already been processed
#   # Subset data for the current county
calgam_i <- pist_gam[pist_gam$county == county, ]
# Fit GAM model to detrend the production time series
calacf_i<- acf(calgam_i$detrended_yield,lag.max = 3,plot=F, na.action=na.pass, calc.ci = TRUE)
temp_plot<-plot(calacf_i, main = unique(calgam_i$county))
}
