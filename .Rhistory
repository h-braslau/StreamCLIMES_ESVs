#Remove empty columns
Blueberry_Data_2024$...25 <- NULL
#format date column from character to date
date <- as.Date(mdy(Blueberry_Data_2024$Date))
Blueberry_Data_2024$Date <- date
#format FarmID from numeric to factor
farmID <- as.factor((Blueberry_Data_2024$FarmID))
Blueberry_Data_2024$FarmID <- farmID
#add new column for Nodes/in for each stem
Blueberry_Data_2024$Stem_A_Nodes_per_Inch <- Blueberry_Data_2024$Stem_A_Nodes/Blueberry_Data_2024$Stem_A_Length
Blueberry_Data_2024$Stem_B_Nodes_per_Inch <- Blueberry_Data_2024$Stem_B_Nodes/Blueberry_Data_2024$Stem_B_Length
Blueberry_Data_2024$Stem_C_Nodes_per_Inch <- Blueberry_Data_2024$Stem_C_Nodes/Blueberry_Data_2024$Stem_C_Length
stem_A_Nodes_per_inch <- Blueberry_Data_2024$Stem_A_Nodes_per_Inch
stem_B_Nodes_per_inch <- Blueberry_Data_2024$Stem_B_Nodes_per_Inch
stem_C_Nodes_per_inch <- Blueberry_Data_2024$Stem_C_Nodes_per_Inch
#subset Nodes/in columns into a new dataframe + calculate av Nodes/in for each plant
Nodes_per_inch <- subset(Blueberry_Data_2024[25:27])
Blueberry_Data_2024$Av_Nodes_per_Inch <- rowMeans(Nodes_per_inch)
#graph Node/inch facueted by farm
ggplot(data = Blueberry_Data_2024, aes(x = Plant_Number, y = Av_Nodes_per_Inch)) + geom_point() + facet_wrap(~FarmID)
ggplot(data = Blueberry_Data_2024, aes(x = Plant_Number, y = Av_Nodes_per_Inch, color = FarmID )) + geom_point() + geom_smooth()
#average Nodes/inch per farm all plants averaged as a box
ggplot(data = Blueberry_Data_2024, aes(x = Plant_Number, y = Av_Nodes_per_Inch, group = FarmID)) + geom_boxplot()
ggplot(data = Blueberry_Data_2024, aes(x = FarmID, y = Av_Nodes_per_Inch)) + geom_boxplot()
#graph Nodes per inch for the branch per farm
ggplot(data = Blueberry_Data_2024, aes(x = Stem_A_Length, y = Stem_A_Nodes) ) + geom_point() +  facet_wrap(~FarmID)
ggplot(data = Blueberry_Data_2024, aes(x = Plant_Number , y = Stem_A_Nodes_per_Inch)) + geom_point() +  facet_wrap(~FarmID)
ggplot(data = Blueberry_Data_2024, aes(x = FarmID, y = Av_Nodes_per_Inch)) + geom_point()
#graph fruit per node per farm
ggplot(data = Blueberry_Data_2024, aes(x = FarmID, y = Av_fruit)) + geom_boxplot()
#calculate buds per Node
#Stem_A_buds <- as.numeric(Blueberry_Data_2024$Stem_A_buds)
#Stem_B_buds <- as.numeric(Blueberry_Data_2024$Stem_B_buds)
#Stem_C_buds <- as.numeric(Blueberry_Data_2024$Stem_C_buds)
Stem_A_Nodes <- as.numeric(Blueberry_Data_2024$Stem_A_Nodes)
Stem_B_Nodes <- as.numeric(Blueberry_Data_2024$Stem_B_Nodes)
Stem_C_Nodes <- as.numeric(Blueberry_Data_2024$Stem_C_Nodes)
Stem_A_Buds <-as.numeric(Blueberry_Data_2024$Stem_A_Buds)
Stem_B_Buds <-as.numeric(Blueberry_Data_2024$Stem_B_Buds)
Stem_C_Buds <- as.numeric(Blueberry_Data_2024$Stem_C_Buds)
Stem_A_Leaves <- Blueberry_Data_2024$Stem_A_Leaves
Blueberry_Data_2024$Stem_A_buds_per_Node <- Stem_A_Buds/Stem_A_Nodes
Blueberry_Data_2024$Stem_B_buds_per_Node <- Stem_B_Buds/Stem_B_Nodes
Blueberry_Data_2024$Stem_C_buds_per_Node <- Stem_C_Buds/Stem_C_Nodes
#calculate leaf nodes per inch
Blueberry_Data_2024$Stem_B_Leaf_per_Inch <- Blueberry_Data_2024$Stem_B_Leaves/Blueberry_Data_2024$Stem_B_Length
Blueberry_Data_2024$Stem_C_Leaf_per_Inch <- Blueberry_Data_2024$Stem_C_Leaves/Blueberry_Data_2024$Stem_C_Length
Blueberry_Data_2024$Stem_A_Leaf_per_Inch <- Blueberry_Data_2024$Stem_A_Leaves/Blueberry_Data_2024$Stem_A_Length
